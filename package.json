{
  "name": "terrafirma",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "cmake -S . -B .output/build -DRUN_IN_PLACE=TRUE && cmake --build .output/build -j && bun run stage && cd apps/game/ui && bun run build",
    "stage": "bash scripts/stage-runtime.sh",
    "palette": "bash scripts/palette.sh",
    "components": "cd apps/game/ui && bun run gallery",
    "check:terragen": "bash scripts/terragen-check.sh",
    "check:lab": "bash scripts/lab-check.sh",
    "check:wiki": "bash scripts/wiki-check.sh",
    "check:matter": "bash scripts/matter-check.sh",
    "check:far": "bash scripts/far-check.sh",
    "check:palette": "bash scripts/palette.sh --check",
    "release:gate": "bash scripts/release/gate.sh",
    "release:tag": "bun scripts/release/tag.ts",
    "release:wait": "bun scripts/release/wait.ts",
    "package:linux": "bash scripts/release/package-linux.sh",
    "check:atlas-world": "bash scripts/atlas-world-check.sh",
    "check:window": "bash scripts/window-check.sh",
    "check:bodies": "bash scripts/bodies-check.sh",
    "check:atlas-land": "bash scripts/atlas-land-check.sh",
    "check:atlas-seams": "bash scripts/atlas-seam-check.sh",
    "check:atlas-debug": "bash scripts/atlas-debug-check.sh",
    "check:atlas-dig": "bash scripts/atlas-dig-check.sh"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
