{
  "name": "terrafirma",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "cmake --build build -j && cd ui && bun run build",
    "components": "cd ui && bun run gallery",
    "check:terragen": "bash scripts/terragen-check.sh",
    "check:lab": "bash scripts/lab-check.sh",
    "check:wiki": "bash scripts/wiki-check.sh",
    "check:matter": "bash scripts/matter-check.sh",
    "check:far": "bash scripts/far-check.sh",
    "check:flight": "bash scripts/flight-check.sh",
    "release:gate": "bash scripts/release/gate.sh",
    "release:tag": "bun scripts/release/tag.ts",
    "release:wait": "bun scripts/release/wait.ts",
    "package:linux": "bash scripts/release/package-linux.sh"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
